@* A coloured block with a label, for showing where layout put something. Colour and place come from the caller's style. *@
<div class="chip" style="@Style">@Label</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Inline CSS for this chip: a background, a flex or grid placement, a size.</summary>
    [Parameter] public string? Style { get; set; }
}
