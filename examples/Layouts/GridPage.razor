<Box FlexDirection="FlexDirection.Column" FlexGrow="1" Gap="1" Padding="new Edges(0, 1)">
    <Panel Title="grid-template-columns: 12 1fr 2fr auto · gap 1 · auto-placed, one span" Color="Color.Magenta">
        <Box Display="Display.Grid" GridTemplateColumns="12 1fr 2fr auto" Gap="1">
            <Chip Label="12 cells" />
            <Chip Label="1fr" Background="Color.Green" Foreground="Color.Black" />
            <Chip Label="2fr" Background="Color.Red" />
            <Chip Label="auto: as wide as this" Background="Color.Magenta" />
            <Chip Label="spans two columns" Background="Color.Cyan" Foreground="Color.Black" GridColumn="span 2" />
            <Chip Label="third" Background="Color.Yellow" Foreground="Color.Black" />
            <Chip Label="fourth" />
        </Box>
    </Panel>
    <Panel Title="an app shell: sidebar 20 · header 1 row · main 1fr · footer 1 row, by explicit placement" Color="Color.Magenta">
        <Box Display="Display.Grid" GridTemplateColumns="20 1fr" GridTemplateRows="1 1fr 1" FlexGrow="1" Gap="1">
            <Box GridColumn="1 / 3" GridRow="1" Background="Color.Blue" Padding="new Edges(0, 1)"><Text Color="Color.White">header · grid-column: 1 / 3</Text></Box>
            <Box GridColumn="1" GridRow="2" Background="Color.BrightBlack" Padding="new Edges(0, 1)" FlexDirection="FlexDirection.Column">
                <Text>sidebar</Text><Text Dim="true">grid-row: 2</Text>
            </Box>
            <Box GridColumn="2" GridRow="2" Border="BorderStyle.Single" BorderColor="Color.BrightBlack" Padding="new Edges(0, 1)"><Text Wrap="TextWrap.Wrap">main · the 1fr row takes what the header and footer leave; the 1fr column takes what the sidebar leaves.</Text></Box>
            <Box GridColumn="1 / 3" GridRow="3" Background="Color.Green" Padding="new Edges(0, 1)"><Text Color="Color.Black">footer</Text></Box>
        </Box>
    </Panel>
    <Panel Title="repeat(4, 1fr) with justify-items and align-items" Color="Color.Magenta">
        <Box Display="Display.Grid" GridTemplateColumns="repeat(4, 1fr)" GridTemplateRows="3" Gap="1" JustifyItems="AlignItems.Center" AlignItems="AlignItems.Center">
            <Chip Label="centered" />
            <Chip Label="in" Background="Color.Green" Foreground="Color.Black" />
            <Chip Label="each" Background="Color.Red" />
            <Chip Label="cell" Background="Color.Magenta" />
        </Box>
    </Panel>
</Box>
