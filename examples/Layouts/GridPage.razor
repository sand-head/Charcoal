<div class="page">
    <Panel Title="grid-template-columns: 12 1fr 2fr auto · gap 1 · auto-placed, one span" Color="magenta">
        <div class="grid" style="grid-template-columns: 12 1fr 2fr auto">
            <Chip Label="12 cells" />
            <Chip Label="1fr" Style="background: green; color: black" />
            <Chip Label="2fr" Style="background: red" />
            <Chip Label="auto: as wide as this" Style="background: magenta" />
            <Chip Label="spans two columns" Style="background: cyan; color: black; grid-column: span 2" />
            <Chip Label="third" Style="background: yellow; color: black" />
            <Chip Label="fourth" />
        </div>
    </Panel>
    <Panel Title="an app shell: sidebar 20 · header 1 row · main 1fr · footer 1 row, by explicit placement" Color="magenta">
        <div class="grid shell">
            <div class="header">header · grid-column: 1 / 3</div>
            <div class="sidebar">sidebar<br /><span class="muted">grid-row: 2</span></div>
            <div class="main">main · the 1fr row takes what the header and footer leave; the 1fr column takes what the sidebar leaves.</div>
            <div class="footer">footer</div>
        </div>
    </Panel>
    <Panel Title="repeat(4, 1fr) with justify-items and align-items" Color="magenta">
        <div class="grid" style="grid-template-columns: repeat(4, 1fr); grid-template-rows: 3; justify-items: center; align-items: center">
            <Chip Label="centered" />
            <Chip Label="in" Style="background: green; color: black" />
            <Chip Label="each" Style="background: red" />
            <Chip Label="cell" Style="background: magenta" />
        </div>
    </Panel>
</div>
