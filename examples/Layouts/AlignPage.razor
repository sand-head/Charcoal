<div class="page">
    @foreach (var align in new[] { "stretch", "flex-start", "center", "flex-end" })
    {
        <div class="panel">
            <div class="label"> @align</div>
            <div class="items" style="align-items: @align">
                <Chip Label="1" />
                <Chip Label="2" Style="background: green; color: black; padding: 1 1" />
                <Chip Label="3" Style="background: red; padding: 2 1" />
            </div>
        </div>
    }
</div>
