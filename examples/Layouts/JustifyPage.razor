<div class="page">
    @foreach (var justify in new[] { "flex-start", "center", "flex-end", "space-between", "space-around", "space-evenly" })
    {
        <div class="line">
            <div class="label">@justify</div>
            <div class="items" style="justify-content: @justify">
                <Chip Label="A" />
                <Chip Label="BB" Style="background: green; color: black" />
                <Chip Label="CCC" Style="background: red" />
            </div>
        </div>
    }
</div>
