<Box FlexDirection="FlexDirection.Column" FlexGrow="1" Gap="1" Padding="new Edges(0, 1)">
    @foreach (var justify in Enum.GetValues<JustifyContent>())
    {
        <Box Border="BorderStyle.Single" BorderColor="Color.BrightBlack" Padding="new Edges(0, 1)" Gap="1">
            <Box Width="18"><Text Dim="true">@justify</Text></Box>
            <Box FlexGrow="1" JustifyContent="justify" Gap="1">
                <Chip Label="A" />
                <Chip Label="BB" Background="Color.Green" Foreground="Color.Black" />
                <Chip Label="CCC" Background="Color.Red" />
            </Box>
        </Box>
    }
</Box>
