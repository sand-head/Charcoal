@* A ScrollBox that is focused when the page appears and follows the lines a timer appends. *@
@implements IDisposable

<div class="page">
    <div class="muted">↑ ↓ PageUp PageDown Home End scroll the box; the wheel too. A line is appended every second; End sticks to the bottom.</div>
    <div class="row">
        <ScrollBox @ref="_scroller" class="scroller" StickToBottom="true" Autofocus="true" ScrollTopChanged="StateHasChanged">
            @foreach (var line in _lines)
            {
                <div class="line" @key="line"><span class="muted">@($"{line,4} ")</span>@Words[line % Words.Length]</div>
            }
        </ScrollBox>
        <div class="state">
            <div class="heading">state</div>
            <div class="muted">position @(_scroller?.Position ?? 0)</div>
            <div class="muted">max @(_scroller?.MaxScroll ?? 0)</div>
            <div class="muted">@(_scroller?.AtEnd == true ? "at the end (sticky)" : "scrolled up (unstuck)")</div>
            <div class="muted">@_lines.Count lines</div>
        </div>
    </div>
</div>

@code {
    private static readonly string[] Words = ["the quick brown fox", "jumps over", "the lazy dog", "while the scroll box", "keeps the end in view", "until you scroll up"];
    private readonly List<int> _lines = Enumerable.Range(1, 40).ToList();
    private ScrollBox? _scroller;
    private Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new Timer(_ => InvokeAsync(AppendLine), null, 1000, 1000);
    }

    private void AppendLine()
    {
        _lines.Add(_lines.Count + 1);
        StateHasChanged();
    }

    public void Dispose() => _timer?.Dispose();
}
