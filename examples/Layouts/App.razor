@inject TuiApp Tui

<div class="app" tabindex="0" @onkeydown="OnKey">
    <div class="header">
        <span class="title">Charcoal layouts</span>
        <span class="muted">page @(_page + 1)/@Titles.Length · @Titles[_page] · ← → to browse · q to quit</span>
    </div>

    @switch (_page)
    {
        case 0: <RowColumnPage /> break;
        case 1: <JustifyPage /> break;
        case 2: <AlignPage /> break;
        case 3: <GrowPage /> break;
        case 4: <BordersPage /> break;
        case 5: <AbsolutePage /> break;
        case 6: <WrapPage /> break;
        case 7: <GridPage /> break;
        case 8: <MinSizePage /> break;
        default: <ScrollPage /> break;
    }

    <div class="footer muted">every page is HTML elements and a scoped stylesheet; the source is one .razor file per page</div>
</div>

@code {
    private static readonly string[] Titles =
        ["row and column", "justify-content", "align-items and stretch", "grow, shrink, basis, percent", "borders, padding, text-overflow", "absolute position", "flex-wrap and align-content", "grid", "automatic minimum size", "scrolling"];

    private int _page;

    private void OnKey(KeyboardEventArgs e)
    {
        e.Handled = true;
        if (e.Key.Key == Key.Right)
        {
            _page = (_page + 1) % Titles.Length;
        }
        else if (e.Key.Key == Key.Left)
        {
            _page = (_page + Titles.Length - 1) % Titles.Length;
        }
        else if (e.Key.Text == "q")
        {
            Tui.Exit();
        }
        else
        {
            e.Handled = false;
        }
    }
}
