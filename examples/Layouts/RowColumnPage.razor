<Box FlexGrow="1" Gap="1" Padding="new Edges(0, 1)">
    <Panel Title="row" Color="Color.Cyan">
        <Box Gap="1">
            <Box Border="BorderStyle.Single" Padding="new Edges(0, 1)"><Text>one</Text></Box>
            <Box Border="BorderStyle.Single" Padding="new Edges(0, 1)"><Text>two</Text></Box>
            <Box Border="BorderStyle.Single" Padding="new Edges(0, 1)"><Text>three</Text></Box>
        </Box>
    </Panel>
    <Panel Title="column" Color="Color.Magenta">
        <Box FlexDirection="FlexDirection.Column" Gap="1">
            <Box Border="BorderStyle.Single" Padding="new Edges(0, 1)"><Text>one</Text></Box>
            <Box Border="BorderStyle.Single" Padding="new Edges(0, 1)"><Text>two</Text></Box>
            <Box Border="BorderStyle.Single" Padding="new Edges(0, 1)"><Text>three</Text></Box>
        </Box>
    </Panel>
    <Panel Title="row-reverse" Color="Color.Yellow">
        <Box FlexDirection="FlexDirection.RowReverse" Gap="1">
            <Box Border="BorderStyle.Single" Padding="new Edges(0, 1)"><Text>one</Text></Box>
            <Box Border="BorderStyle.Single" Padding="new Edges(0, 1)"><Text>two</Text></Box>
            <Box Border="BorderStyle.Single" Padding="new Edges(0, 1)"><Text>three</Text></Box>
        </Box>
    </Panel>
</Box>
