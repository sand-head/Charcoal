<div class="page">
    <Panel Title="flex-wrap: wrap · gap 1 · twenty chips in whatever width there is" Color="cyan">
        <div class="wrap">
            @for (var i = 1; i <= 20; i++)
            {
                <Chip Label="@($"chip {i}")" Style="@ChipStyles[i % 3]" />
            }
        </div>
    </Panel>
    <div class="row">
        @foreach (var content in new[] { "flex-start", "center", "flex-end", "space-between", "stretch" })
        {
            <div class="panel">
                <div class="muted">@(" align-content " + content)</div>
                <div class="wrap grow" style="align-content: @content">
                    @for (var i = 1; i <= 6; i++)
                    {
                        <Chip Label="@i.ToString()" Style="@ChipStyles[i % 2 == 0 ? 2 : 1]" />
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private static readonly string[] ChipStyles = ["background: red", "background: blue", "background: green; color: black"];
}
