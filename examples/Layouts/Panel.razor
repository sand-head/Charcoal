@* A titled, bordered column that grows to share the row. *@
<div class="panel" style="border-color: @Color">
    <div class="title" style="color: @Color">@Title</div>
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>A CSS colour for the border and the title.</summary>
    [Parameter] public string Color { get; set; } = "cyan";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
