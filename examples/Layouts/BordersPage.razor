<div class="page">
    @foreach (var (name, css) in Borders)
    {
        <div class="card" style="@css">
            <div class="heading">@name</div>
            <p>This text wraps inside a @name border with padding 1 2.</p>
        </div>
    }
    <div class="overflow">
        <div style="text-overflow: ellipsis">ellipsis: this line is far too long to fit in thirty cells</div>
        <div style="text-overflow: ellipsis clip">ellipsis clip: this line is far too long to fit in thirty cells</div>
        <div style="text-overflow: ellipsis ellipsis">ellipsis ellipsis: this line is far too long to fit in thirty cells</div>
        <div style="text-overflow: clip">clip: this line is far too long to fit in thirty cells</div>
    </div>
</div>

@code {
    private static readonly (string Name, string Css)[] Borders =
    [
        ("solid", "border-style: solid"),
        ("double", "border-style: double"),
        ("border-radius", "border-style: solid; border-radius: 1"),
        ("thick", "border-style: solid; border-width: thick"),
        ("dashed", "border-style: dashed"),
    ];
}
