@* A focusable counter that takes + and − while focused. :focus in the scoped sheet shows which one has the keyboard. *@
<div class="counter" tabindex="0" @onkeydown="OnKey" @onclick="OnClick">
    <div class="name">@Model.Name</div>
    <div class="value">@Model.Value</div>
</div>

@code {
    [Parameter, EditorRequired] public App.CounterModel Model { get; set; } = default!;

    private void OnKey(KeyboardEventArgs e)
    {
        switch (e.Key.Text)
        {
            case "+" or "=":
                Model.Value++;
                e.Handled = true;
                break;
            case "-" or "_":
                Model.Value--;
                e.Handled = true;
                break;
        }
    }

    private void OnClick(MouseEventArgs e)
    {
        if (e.Mouse.Button == MouseButton.Right)
        {
            Model.Value--;
        }
        else
        {
            Model.Value++;
        }
        e.Handled = true;
    }
}
