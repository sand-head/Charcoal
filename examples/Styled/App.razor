@inject TuiApp Tui

<div class="page" @onkeypress="OnKey">
    <div class="title">styled with a stylesheet</div>
    <div class="muted">Tab moves focus between the cards; the focused card's border and heading turn green through :focus rules. q quits.</div>
    <div class="cards">
        <div class="card" tabindex="0">
            <div class="heading">plain card</div>
            <p>Its colour is white because .card says so and text inherits it; its text wraps because that is what text does.</p>
        </div>
        <div class="card warn" tabindex="0">
            <div class="heading">warning card</div>
            <p>Two classes: .card for the shape, .warn for the yellow border. The :focus rule wins the border while it has focus: same specificity, later in the sheet.</p>
        </div>
        <div class="card" tabindex="0" style="border-style: double">
            <div class="heading">inline style</div>
            <p>An inline style attribute beats any rule: this border is double whatever the sheet says.</p>
        </div>
    </div>
    <div id="footer">#footer is an id selector, and italic comes from it.</div>
</div>

@code {
    private void OnKey(KeyPressEventArgs e)
    {
        if (e.Key.Text != "q") return;
        Tui.Exit();
        e.Handled = true;
    }
}
