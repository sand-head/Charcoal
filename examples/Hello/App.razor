@inject TuiApp Tui

<Box FlexDirection="FlexDirection.Column" Padding="new Edges(1, 2)" @onkeypress="OnKey" focusable="true">
    <Box Border="BorderStyle.Round" BorderColor="Color.Cyan" Padding="new Edges(0, 1)">
        <Text Bold="true" Color="Color.Green">Hello from sloptui</Text>
    </Box>
    <Text Dim="true">Press q to quit. Terminal is @Tui.Size.Width×@Tui.Size.Height cells.</Text>
    <Text>HTML inline tags work: <strong>strong</strong>, <em>em</em>, <u>u</u>, <s>s</s>, <mark>mark</mark><br />and a <span color="magenta">span</span> after a br.</Text>
    <div color="cyan" margin-top="1">
        Bare text under a div needs no Text element, and a div stacks its children.
        <img src="sloptui.png" alt="[sloptui.png]" width="24" />
        <p>An <em>img</em> is a leaf sized from its pixels; here it was given a width.</p>
    </div>
</Box>

@code {
    private void OnKey(KeyPressEventArgs e)
    {
        if (e.Key.Text != "q") return;
        Tui.Exit();
        e.Handled = true;
    }
}
