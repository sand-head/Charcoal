@inject TuiApp Tui

<div class="app" tabindex="0" @onkeypress="OnKey">
    <div class="banner">Hello from sloptui</div>
    <div class="muted">Press q to quit. Terminal is @Tui.Size.Width×@Tui.Size.Height cells.</div>
    <p>HTML inline tags work: <strong>strong</strong>, <em>em</em>, <u>u</u>, <s>s</s>, <mark>mark</mark><br />and a <span style="color: magenta">span</span> after a br.</p>
    <div class="picture">
        Bare text under a div needs no component, and a div stacks its children.
        <img src="sloptui.png" alt="[sloptui.png]" width="24" />
        <p>An <em>img</em> is a leaf sized from its pixels; here it was given a width.</p>
    </div>
</div>

@code {
    private void OnKey(KeyPressEventArgs e)
    {
        if (e.Key.Text != "q") return;
        Tui.Exit();
        e.Handled = true;
    }
}
