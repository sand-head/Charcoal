@*
    A one-line editor. The caret attribute places the terminal's cursor, and
    :focus in the scoped sheet colours the border while it has the keyboard.
*@
<div class="composer" tabindex="0" caret="@($"{2 + _caret},0")" @onkeypress="OnKey" @onpaste="OnPaste"><span class="prompt">❯ </span>@_text</div>

@code {
    [Parameter] public EventCallback<string> OnSubmit { get; set; }

    private string _text = "";
    private int _caret;

    private async Task OnKey(KeyPressEventArgs e)
    {
        var key = e.Key;
        e.Handled = true;
        switch (key.Key)
        {
            case Key.Enter:
                await SubmitAsync();
                return;
            case Key.Backspace:
                if (_caret > 0)
                {
                    _caret--;
                    _text = _text.Remove(_caret, 1);
                }
                return;
            case Key.Delete:
                if (_caret < _text.Length) _text = _text.Remove(_caret, 1);
                return;
            case Key.Left:
                _caret = Math.Max(0, _caret - 1);
                return;
            case Key.Right:
                _caret = Math.Min(_text.Length, _caret + 1);
                return;
            case Key.Home:
                _caret = 0;
                return;
            case Key.End:
                _caret = _text.Length;
                return;
        }

        if (key.IsCtrl('u'))
        {
            Clear();
        }
        else if (key.IsText)
        {
            Insert(key.Text);
        }
        else
        {
            e.Handled = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_text.Length == 0) return;
        var submitted = _text;
        Clear();
        await OnSubmit.InvokeAsync(submitted);
    }

    private void Clear()
    {
        _text = "";
        _caret = 0;
    }

    private void Insert(string text)
    {
        _text = _text.Insert(_caret, text);
        _caret += text.Length;
    }

    private void OnPaste(PasteEventArgs e)
    {
        Insert(e.Text.ReplaceLineEndings(" "));
        e.Handled = true;
    }
}
