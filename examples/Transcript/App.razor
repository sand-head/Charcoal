@inject TuiApp Tui
@inject IServiceProvider Services
@implements IDisposable

@*
    The transcript clips its overflow, so it is the column that shrinks; the
    rows around it keep their content's height.
*@
<div class="app" @onkeydown="OnKey">
    <div class="bar">
        <span class="name">transcript</span>
        <span class="muted">@_lines.Count lines · @(_streaming ? "streaming" : "paused") · F1 pauses · Enter sends · @(QuitConfirming ? "Ctrl+C again quits" : "Ctrl+C quits")</span>
    </div>

    @* The newest line sits at the bottom, just above the composer. *@
    <div class="transcript">
        @foreach (var line in _lines)
        {
            <Entry @key="line.Id" Line="line" />
        }
    </div>

    <Composer OnSubmit="Submit" />

    <div class="bar muted">
        <span>frame @Tui.FrameCount</span>
        <span>layout @Tui.LastFrame.Layout.TotalMilliseconds.ToString("F2") ms</span>
        <span>paint @Tui.LastFrame.Paint.TotalMilliseconds.ToString("F2") ms</span>
        <span>flush @Tui.LastFrame.Flush.TotalMilliseconds.ToString("F2") ms</span>
        <span>@Tui.LastFrame.Bytes bytes</span>
    </div>
</div>

@code {
    [Parameter] public int Preload { get; set; } = 2000;
    [Parameter] public bool Streaming { get; set; } = true;

    private readonly List<Line> _lines = [];
    private readonly Random _random = new(7);
    private bool _streaming;
    private Timer? _timer;
    private int _wordsLeft;
    private DateTime _quitAsked;

    private bool QuitConfirming => (DateTime.UtcNow - _quitAsked).TotalSeconds < 2;

    private static readonly string[] Words =
        "the quick brown fox jumps over the lazy dog while a component tree of ten thousand lines stays cheap because only what changed is measured painted and flushed".Split(' ');

    protected override void OnInitialized()
    {
        for (var i = 0; i < Preload; i++)
        {
            var speaker = i % 7 == 0 ? Speaker.User : Speaker.Agent;
            _lines.Add(new Line(i, speaker, Sentence(_random.Next(4, 30))));
        }
        (Services.GetService(typeof(AppHandle)) as AppHandle)?.Register(this);
        if (Streaming) StartStreaming();
    }

    private void StartStreaming()
    {
        _streaming = true;
        _timer ??= new Timer(_ => InvokeAsync(StreamOnce), null, 60, 60);
    }

    private void StopStreaming()
    {
        _streaming = false;
        _timer?.Dispose();
        _timer = null;
    }

    /// <summary>Appends a word to the last agent line, or starts a new line.</summary>
    public void StreamOnce()
    {
        if (_wordsLeft <= 0 || _lines.Count == 0 || _lines[^1].Speaker != Speaker.Agent)
        {
            _lines.Add(new Line(_lines.Count, Speaker.Agent, ""));
            _wordsLeft = _random.Next(6, 40);
        }
        var last = _lines[^1];
        var separator = last.Text.Length == 0 ? "" : " ";
        last.Append(separator + RandomWord());
        _wordsLeft--;
        StateHasChanged();
    }

    private string RandomWord() => Words[_random.Next(Words.Length)];

    private string Sentence(int words) => string.Join(' ', Enumerable.Range(0, words).Select(_ => RandomWord()));

    private void Submit(string text)
    {
        _lines.Add(new Line(_lines.Count, Speaker.User, text));
        _wordsLeft = 0;
    }

    private void OnKey(KeyboardEventArgs e)
    {
        // With text selected, Ctrl+C keeps its default action and copies.
        if (e.Key.IsCtrl('c') && !Tui.Selection.Active)
        {
            if (QuitConfirming)
            {
                Tui.Exit();
            }
            else
            {
                _quitAsked = DateTime.UtcNow;
            }
            e.Handled = true;
            return;
        }

        if (e.Key.Key != Key.F1) return;

        if (_streaming)
        {
            StopStreaming();
        }
        else
        {
            StartStreaming();
        }
        e.Handled = true;
    }

    public void Dispose() => _timer?.Dispose();

    public enum Speaker { User, Agent }

    /// <summary>A transcript line whose version changes with its text.</summary>
    public sealed class Line(int id, Speaker speaker, string text)
    {
        public int Id { get; } = id;
        public Speaker Speaker { get; } = speaker;
        public string Text { get; private set; } = text;
        public int Version { get; private set; }

        public void Append(string more)
        {
            Text += more;
            Version++;
        }
    }
}
