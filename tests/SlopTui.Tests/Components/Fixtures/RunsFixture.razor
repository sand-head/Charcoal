@* Spans on separate, indented lines. The first div keeps its whitespace, as a pre would. *@
<div id="pre" style="white-space: pre-wrap">
    <span style="color: red">one</span>
    <span>  two</span>
    <span>@("  three")</span>
    @if (Show)
    {
        <span> four</span>
    }
</div>
<div id="normal">
    <span style="color: red">one</span>
    <span>  two</span>
    <span>@("  three")</span>
</div>
<div id="break">
    <span>a</span><br /><span>b</span>
</div>

@code {
    [Parameter] public bool Show { get; set; } = true;
}
