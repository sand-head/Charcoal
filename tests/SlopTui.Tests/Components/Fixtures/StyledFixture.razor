@*
    Two focusable panels under a class the app's stylesheet targets. The
    stylesheet colours the focused panel's text through :focus-within and
    marks the "hot" panel; the fixture toggles the class from a key.
*@
<div class="@RootClass" id="root" @onkeydown="OnKey">
    <div class="panel" id="first" tabindex="0">
        <p id="first-text">first</p>
    </div>
    <div class="@("panel" + (Hot ? " hot" : ""))" id="second" tabindex="0">
        <p id="second-text">second</p>
    </div>
</div>

@code {
    public static StyledFixture? Last;
    public bool Hot;
    public string RootClass = "app";

    protected override void OnInitialized() => Last = this;

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key.Text == "h") { Hot = !Hot; e.Handled = true; }
    }
}
