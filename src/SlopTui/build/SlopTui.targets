<Project>

  <!--
    Embeds the Razor SDK's bundle of component-scoped CSS (Component.razor.css)
    in the assembly, where TuiApp loads it at start. A web app would link the
    bundle from its page instead.
  -->
  <PropertyGroup>
    <SlopTuiEmbedScopedCss Condition="'$(SlopTuiEmbedScopedCss)' == ''">true</SlopTuiEmbedScopedCss>
  </PropertyGroup>

  <Target Name="SlopTuiEmbedScopedCss"
          Condition="'$(SlopTuiEmbedScopedCss)' == 'true'"
          DependsOnTargets="GenerateScopedCssFiles"
          BeforeTargets="AssignTargetPaths;SplitResourcesByCulture">
    <!-- Must run before resource names are assigned. -->
    <ItemGroup>
      <EmbeddedResource Include="$(_ScopedCssProjectOutputFullPath)"
                        Condition="'$(_ScopedCssProjectOutputFullPath)' != '' and Exists('$(_ScopedCssProjectOutputFullPath)')"
                        LogicalName="$(AssemblyName).bundle.scp.css"
                        Visible="false" />
    </ItemGroup>
  </Target>

</Project>
