@*
    A canvas painted by the Paint delegate into a buffer clipped to its
    content box. Call TuiApp.Invalidate() when what it draws changes without
    a re-render. Size and place it with style or class, like any element.
*@
@inject TuiApp Tui

<canvas @ref="_element" @attributes="AdditionalAttributes"></canvas>

@code {
    private ElementReference _element;

    [Parameter, EditorRequired] public Action<CellBuffer, Rect> Paint { get; set; } = default!;

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The rendered canvas element, once there is one.</summary>
    public HostElement? Element => Tui.Renderer.Element(_element);

    protected override void OnAfterRender(bool firstRender)
    {
        if (Element is not { } element || ReferenceEquals(element.Painter, Paint)) return;
        element.Painter = Paint;
        Tui.Invalidate();
    }
}
