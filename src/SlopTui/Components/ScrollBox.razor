@*
    A scrolling box, driven by the arrow and page keys when focused and by the
    mouse wheel. ScrollTop binds two-way. With StickToBottom, growing content
    stays in view while the end is showing.

    The box's size and its content's come from the layout after each frame,
    so a scroll requested before the first frame lands on the next one.
*@
@implements IDisposable
@inject TuiApp Tui

<box id="@_id" overflow="scroll" scroll-y="@_scroll" flex-direction="@Direction" focusable="@Focusable" @onkeypress="OnKey" @onmouse="OnMouse" @onfocus="() => Focused = true" @onblur="() => Focused = false" @attributes="Attributes()">
    @ChildContent
</box>

@code {
    private static long _next;
    private readonly string _id = "scrollbox-" + Interlocked.Increment(ref _next);
    private int _scroll;
    private int _viewport;
    private int _content;
    private bool _atEnd = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The flex direction of the content, a column by default.</summary>
    [Parameter] public FlexDirection Direction { get; set; } = FlexDirection.Column;

    [Parameter] public bool Focusable { get; set; } = true;

    /// <summary>
    /// The first content row to show. Only a changed value moves the box, so
    /// an unbound parent re-rendering does not undo the user's scrolling; read
    /// <see cref="Position"/> for where the box is now.
    /// </summary>
    [Parameter] public int ScrollTop { get; set; }
    [Parameter] public EventCallback<int> ScrollTopChanged { get; set; }

    public int Position => _scroll;

    private int _lastScrollTopParameter;

    [Parameter] public bool StickToBottom { get; set; }

    /// <summary>Rows scrolled per wheel notch.</summary>
    [Parameter] public int WheelRows { get; set; } = 3;

    [Parameter] public double? FlexGrow { get; set; }
    [Parameter] public double? FlexShrink { get; set; }
    [Parameter] public Length? Width { get; set; }
    [Parameter] public Length? Height { get; set; }
    [Parameter] public Length? MinHeight { get; set; }
    [Parameter] public Length? MaxHeight { get; set; }
    [Parameter] public Edges? Padding { get; set; }
    [Parameter] public Edges? Margin { get; set; }
    [Parameter] public Color? Background { get; set; }
    [Parameter] public BorderStyle? Border { get; set; }
    [Parameter] public Color? BorderColor { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private Dictionary<string, object> Attributes()
    {
        var attributes = new Dictionary<string, object>(AdditionalAttributes ?? new Dictionary<string, object>(), StringComparer.Ordinal);
        Put(attributes, "flex-grow", FlexGrow);
        Put(attributes, "flex-shrink", FlexShrink);
        Put(attributes, "width", Width);
        Put(attributes, "height", Height);
        Put(attributes, "min-height", MinHeight);
        Put(attributes, "max-height", MaxHeight);
        Put(attributes, "padding", Padding);
        Put(attributes, "margin", Margin);
        Put(attributes, "background", Background);
        Put(attributes, "border", Border);
        Put(attributes, "border-color", BorderColor);
        return attributes;
    }

    private static void Put<T>(Dictionary<string, object> attributes, string name, T? value) where T : struct
    {
        if (value is { } set) attributes[name] = set;
    }

    public bool Focused { get; private set; }

    /// <summary>The furthest the box can scroll, as of the last frame.</summary>
    public int MaxScroll => Math.Max(0, _content - _viewport);

    public bool AtEnd => _scroll >= MaxScroll;

    protected override void OnInitialized() => Tui.FramePainted += OnFrame;

    protected override void OnParametersSet()
    {
        if (ScrollTop == _lastScrollTopParameter) return;
        _lastScrollTopParameter = ScrollTop;
        _scroll = Math.Max(0, ScrollTop);
        _atEnd = _scroll >= MaxScroll;
    }

    public void Dispose() => Tui.FramePainted -= OnFrame;

    /// <summary>Scrolls by a number of rows, negative for up.</summary>
    public Task ScrollByAsync(int rows) => ScrollToAsync(_scroll + rows);

    public Task ScrollToEndAsync() => ScrollToAsync(int.MaxValue);

    /// <summary>Scrolls to a row, clamped to the content.</summary>
    public async Task ScrollToAsync(int row)
    {
        var clamped = Math.Clamp(row, 0, MaxScroll);
        _atEnd = clamped >= MaxScroll;
        if (clamped == _scroll) return;
        _scroll = clamped;
        await ScrollTopChanged.InvokeAsync(_scroll);
        StateHasChanged();
    }

    private void OnFrame(FrameStats stats)
    {
        var element = Tui.Renderer.Root.Descendants().OfType<HostElement>().FirstOrDefault(e => e.Id == _id);
        if (element is null) return;

        var node = element.Node;
        var inner = node.Layout.Deflate(node.Style.Inset);
        var vertical = Direction is FlexDirection.Column or FlexDirection.ColumnReverse;
        var viewport = vertical ? inner.Height : inner.Width;
        var content = vertical ? node.ContentSize.Height : node.ContentSize.Width;
        if (viewport == _viewport && content == _content) return;
        _viewport = viewport;
        _content = content;

        // Follow growing content while at the end, and pull back when it shrinks.
        var target = StickToBottom && _atEnd ? MaxScroll : Math.Min(_scroll, MaxScroll);
        if (target != _scroll)
        {
            _ = Tui.InvokeAsync(() => ScrollToAsync(target));
        }
    }

    private async Task OnKey(KeyPressEventArgs e)
    {
        var page = Math.Max(1, _viewport - 1);
        var scroll = e.Key.Key switch
        {
            Key.Up => ScrollByAsync(-1),
            Key.Down => ScrollByAsync(1),
            Key.PageUp => ScrollByAsync(-page),
            Key.PageDown => ScrollByAsync(page),
            Key.Home => ScrollToAsync(0),
            Key.End => ScrollToEndAsync(),
            _ => null,
        };
        if (scroll is null) return;
        e.Handled = true;
        await scroll;
    }

    private async Task OnMouse(MouseEventArgs e)
    {
        var delta = e.Mouse.Action switch
        {
            MouseAction.WheelUp => -WheelRows,
            MouseAction.WheelDown => WheelRows,
            _ => 0,
        };
        if (delta == 0) return;
        e.Handled = true;
        await ScrollByAsync(delta);
    }
}
